{"concepts":[{"definition":"复数的人生活在地球上，而不是单数的人。政治的前提是人与人的不同与平等。","en":"plurality","id":"plurality","layer":"vita-activa","prerequisite":[],"related":["action","public-realm","friendship"],"works":["human-condition"],"zh":"复数性"},{"definition":"每一次出生都是一个新的开始；人有能力开始一件前所未有的事。","en":"natality","id":"natality","layer":"vita-activa","prerequisite":["plurality"],"related":["action","beginning"],"works":["human-condition"],"zh":"出生性"},{"definition":"在他人面前通过言说与行动显现自己是谁。行动需要复数性，需要公共领域。","en":"action","id":"action","layer":"vita-activa","prerequisite":["plurality","natality"],"related":["power","public-realm","storytelling"],"works":["human-condition","on-revolution"],"zh":"行动"},{"definition":"维持生命的循环活动，做完就消失，不留下世界。","en":"labor","id":"labor","layer":"vita-activa","prerequisite":[],"related":["work","animal-laborans"],"works":["human-condition"],"zh":"劳动"},{"definition":"制造耐用物品、建造世界的活动；做出来的东西留得下来。","en":"work","id":"work","layer":"vita-activa","prerequisite":[],"related":["labor","world"],"works":["human-condition"],"zh":"工作"},{"definition":"人与人共同行动时产生的东西；需要人数，消失于人散去时。","en":"power","id":"power","layer":"vita-activa","prerequisite":["action","plurality"],"related":["violence","authority"],"works":["human-condition","on-violence"],"zh":"权力"},{"definition":"工具性的手段；只需要工具，不需要人数；摧毁权力，不能创造权力。","en":"violence","id":"violence","layer":"vita-activa","prerequisite":["power"],"related":["power","strength"],"works":["on-violence"],"zh":"暴力"},{"definition":"众人一起显现、说话、行动的空间；没有它，行动无处发生。","en":"public realm","id":"public-realm","layer":"vita-activa","prerequisite":["action"],"related":["private-realm","social-realm","plurality"],"works":["human-condition"],"zh":"公共领域"},{"definition":"与自己对话、退回内在的空间；没有它，公共领域没有根。","en":"private realm","id":"private-realm","layer":"vita-activa","prerequisite":[],"related":["public-realm","solitude"],"works":["human-condition"],"zh":"私人领域"},{"definition":"经济与生存事务上升为公共关切的领域；她认为它侵蚀了真正的政治。","en":"the social","id":"social-realm","layer":"vita-activa","prerequisite":["public-realm"],"related":["labor"],"works":["human-condition"],"zh":"社会领域"},{"definition":"恶不一定来自怪物，也可能来自一个不思考、只照章办事的普通人。","en":"banality of evil","id":"banality-of-evil","layer":"vita-activa","prerequisite":["totalitarianism","thoughtlessness"],"related":["thoughtlessness","judging"],"works":["eichmann-jerusalem"],"works_note":"后世研究（Bettina Stangneth《艾希曼在耶路撒冷之前》2011）指出艾希曼的自我呈现可能有表演成分；本项目讲两边，不把争议写成定论。","zh":"平庸之恶"},{"definition":"不思考、不用自己的头脑判断，只照既有规则和套话行事。","en":"thoughtlessness","id":"thoughtlessness","layer":"vita-contemplativa","prerequisite":[],"related":["banality-of-evil","thinking"],"works":["eichmann-jerusalem","life-of-mind"],"zh":"无思"},{"definition":"与自己进行的无声对话；思考的前提是与自己不自相矛盾。","en":"thinking","id":"thinking","layer":"vita-contemplativa","prerequisite":["solitude"],"related":["thoughtlessness","willing","judging"],"works":["life-of-mind"],"zh":"思考"},{"definition":"说“我愿意 / 我不愿意”的心灵能力；与思考不同，它面向未来。","en":"willing","id":"willing","layer":"vita-contemplativa","prerequisite":["thinking"],"related":["thinking","judging"],"works":["life-of-mind"],"zh":"意志"},{"definition":"在没有普遍标准时，仍然能说“这是美的 / 这是不对的”。","en":"judging","id":"judging","layer":"vita-contemplativa","prerequisite":["thinking","willing"],"related":["thinking","sensus-communis"],"works":["life-of-mind","lectures-kant"],"zh":"判断"},{"definition":"既没有他人也没有自己；连与自己对话都做不到。是极权的温床。","en":"loneliness","id":"loneliness","layer":"vita-activa","prerequisite":[],"related":["isolation","solitude","totalitarianism"],"works":["origins-totalitarianism"],"zh":"孤独"},{"definition":"没有他人，但还有自己；还能思考。是思考的前提，不是病。","en":"isolation","id":"isolation","layer":"vita-activa","prerequisite":[],"related":["loneliness","solitude"],"works":["origins-totalitarianism"],"zh":"孤立"},{"definition":"独处：与自己在一起，是思考开始的地方。","en":"solitude","id":"solitude","layer":"vita-contemplativa","prerequisite":[],"related":["loneliness","isolation","thinking"],"works":["human-condition","life-of-mind"],"zh":"独处"},{"definition":"一种全新的统治形式：意识形态 + 恐怖，让整类人变得多余。","en":"totalitarianism","id":"totalitarianism","layer":"vita-activa","prerequisite":["loneliness"],"related":["loneliness","ideology"],"works":["origins-totalitarianism"],"zh":"极权主义"},{"definition":"爱世界：愿意让世界继续存在、愿意为它负责任、愿意在其中开始新的事。她原想以此为《人的境况》题名。","en":"amor mundi","id":"amor-mundi","layer":"vita-activa","prerequisite":["love","world"],"related":["love","world","beginning"],"works":["human-condition"],"zh":"爱世界"},{"definition":"爱摧毁两人之间的中介，只看见“你是谁”，不要复数性；因此爱是非政治的，甚至是反政治的。","en":"love","id":"love","layer":"vita-activa","prerequisite":[],"related":["amor-mundi","friendship"],"works":["love-augustine","human-condition"],"zh":"爱"},{"definition":"在共同世界里保持距离、说真话的关系；她认为这是最政治的关系。","en":"friendship","id":"friendship","layer":"vita-activa","prerequisite":["plurality"],"related":["love","public-realm"],"works":["men-in-dark-times"],"zh":"友谊"},{"definition":"故事揭示意义，却不定义意义。讲故事是行动之后，意义显现的方式。","en":"storytelling","id":"storytelling","layer":"vita-activa","prerequisite":["action"],"related":["action","world"],"works":["human-condition","men-in-dark-times"],"zh":"讲故事"},{"definition":"原谅让行动者从不可逆的后果中解脱；承诺让行动者对不可预测的未来负责。","en":"forgiveness / promise","id":"forgiveness-promise","layer":"vita-activa","prerequisite":["action"],"related":["action"],"works":["human-condition"],"zh":"宽恕与承诺"},{"definition":"人造的、耐用的、共同的世界；爱世界就是爱这个世界。","en":"world","id":"world","layer":"vita-activa","prerequisite":["work"],"related":["amor-mundi","public-realm"],"works":["human-condition"],"zh":"世界"}]}